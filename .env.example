# Base URL for the storefront API. In development this is proxied by Vite
# (see vite.config.js) to the backend on port 3000. For production builds set
# this to the API origin, e.g. https://api.example.com
VITE_API_BASE_URL=/api

# WhatsApp number in international format, without + or spaces.
VITE_WHATSAPP_NUMBER=+8801917335945